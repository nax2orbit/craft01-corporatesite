<!--<h1 class="text-center">Welcome to Our Site</h1>-->
<div data-controller="carousel">
  <div id="carouselExampleCaptions" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-indicators">
      <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
      <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="1" aria-label="Slide 2"></button>
      <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>

    <div class="carousel-inner">
      <div class="carousel-item active">
        <%= image_tag "image1.jpg", class: "d-block w-100 carousel-img", alt: "First Slide" %>
        <div class="carousel-caption d-none d-md-block carousel-caption-bg-white text-dark">
          <h5>Slide 1 Title</h5>
          <p>This is the first slide's description.</p>
        </div>
      </div>
      
      <div class="carousel-item">
        <%= image_tag "image2.jpg", class: "d-block w-100 carousel-img", alt: "Second Slide" %>
        <div class="carousel-caption d-none d-md-block carousel-caption-bg-white text-dark">
          <h5>Slide 2 Title</h5>
          <p>This is the second slide's description.</p>
        </div>
      </div>

      <div class="carousel-item">
        <%= image_tag "image3.jpg", class: "d-block w-100 carousel-img", alt: "Third Slide" %>
        <div class="carousel-caption d-none carousel-caption-bg-black d-md-block">
          <h5>Slide 3 Title</h5>
          <p>This is the third slide's description.</p>
        </div>
      </div>
    </div>


      <!-- 前へ -->
    <button class="carousel-control-prev carousel-arrow" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>

    <!-- 次へ -->
    <button class="carousel-control-next carousel-arrow" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
      </button>
  </div>
</div>

<!-- セクション1：画像左・テキスト右 -->
<div class="container my-5">
  <div class="row align-items-center">
    <div class="col-md-6">
      <%= image_tag "image4.jpg", class: "img-fluid", alt: "Image 4" %>
    </div>
    <div class="col-md-6">
      <h3>タイトル1</h3>
      <p>これは画像4の説明文です。左に画像、右にテキストのレイアウトです。</p>
    </div>
  </div>
</div>

<!-- セクション2：画像右・テキスト左 -->
<div class="container my-5">
  <div class="row align-items-center flex-md-row-reverse">
    <div class="col-md-6">
      <%= image_tag "image5.jpg", class: "img-fluid", alt: "Image 5" %>
    </div>
    <div class="col-md-6">
      <h3>タイトル2</h3>
      <p>こちらは画像5の説明文。今度は右に画像、左にテキストのパターンです。</p>
    </div>
  </div>
</div>

<!-- お問い合わせボタン -->
<div class="text-center my-5">
  <%= link_to "お問い合わせ", contact_path, class: "btn btn-primary btn-lg" %>
</div>
